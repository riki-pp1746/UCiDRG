# Salin ke .env.local. Jangan commit .env.local.
# Ambil Publishable key dari Supabase Project Settings → API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_VERSION=1.0.0

# Opsional. Isi di Vercel untuk mengaktifkan login dengan Slide Puzzle GeeTest v4.
VITE_GEETEST_CAPTCHA_ID=
# Dua kunci ini hanya untuk server. Jangan beri awalan VITE_ atau NEXT_PUBLIC_.
GEETEST_CAPTCHA_KEY=
SUPABASE_SECRET_KEY=
